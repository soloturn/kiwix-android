<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup keeps internal user data but excludes external ZIMs and imported EPUB copies. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="." />
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="external" />
    <exclude domain="file" path="epub/" />
    <exclude domain="file" path="epub_covers/" />
  </cloud-backup>
</data-extraction-rules>
