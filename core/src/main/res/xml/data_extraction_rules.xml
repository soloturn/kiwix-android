<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Imported EPUB copies (filesDir/epub, epub_covers) would blow the 25 MB cloud-backup
  quota, which stops backup of the whole app incl. bookmarks and notes. No device-transfer section:
  that has no quota, so it keeps carrying everything incl. the books the library DB refers to.
  Reading positions live in the DataStore prefs and stay backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" />
        <exclude domain="file" path="epub/" />
        <exclude domain="file" path="epub_covers/" />
    </cloud-backup>
</data-extraction-rules>
