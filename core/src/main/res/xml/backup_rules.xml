<?xml version="1.0" encoding="utf-8"?>

<!-- Internal user data is backed up. External app files may contain multi-GB ZIMs, and imported EPUB copies and covers exceed the cloud quota. -->
<full-backup-content>
  <include domain="file" path="." />
  <include domain="database" path="." />
  <include domain="sharedpref" path="." />
  <exclude domain="external" />
  <exclude domain="file" path="epub/" />
  <exclude domain="file" path="epub_covers/" />
</full-backup-content>
